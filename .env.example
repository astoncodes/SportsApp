# Copy to .env and fill in. NEVER commit .env — see .gitignore.
#
# SECURITY BOUNDARY (docs/architecture.md §Access control):
#   EXPO_PUBLIC_* and VITE_* are compiled into client bundles and are readable
#   by anyone who installs the app or opens devtools. Only ever put the
#   publishable/anon key there — it is safe precisely because Row Level Security
#   constrains what it can do.
#   The service-role key and the database password MUST NOT appear in either
#   prefix, in any committed file, or in a test snapshot.

# ---------------------------------------------------------------------------
# Client-side (safe to ship in a bundle, constrained by RLS)
# ---------------------------------------------------------------------------

# Hosted Supabase project URL and publishable key from the dashboard.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Geoapify location search. Public key; apply provider restrictions.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Mapbox public access token (pk.*), used by native and web maps.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Admin review app — Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only (never reaches a browser or device)
# ---------------------------------------------------------------------------

# Admin maintenance — connects directly to Postgres as a privileged dev user.
# Hosted connection string from Supabase Connect; used only for privileged tools.
SUPABASE_DB_URL=

# Optional CLI / isolated database testing. Never use the app project for db:test.
SUPABASE_PROJECT_REF=
SUPABASE_TEST_PROJECT_REF=
SUPABASE_TEST_DB_URL=
