# Copy to .env and fill in. NEVER commit .env — see .gitignore.
#
# SECURITY BOUNDARY (docs/architecture.md §Access control):
#   EXPO_PUBLIC_* and VITE_* are compiled into client bundles and are readable
#   by anyone who installs the app or opens devtools. Only ever put the
#   publishable/anon key there — it is safe precisely because Row Level Security
#   constrains what it can do.
#   The service-role key and the database password MUST NOT appear in either
#   prefix, in any committed file, or in a test snapshot.

# ---------------------------------------------------------------------------
# Client-side (safe to ship in a bundle, constrained by RLS)
# ---------------------------------------------------------------------------

# Mobile app — Expo. Local Supabase prints these on `npm run db:start`.
# On a simulator/emulator, localhost will not resolve to your machine: use the
# LAN IP (e.g. http://192.168.1.20:54321) when testing on a physical device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Admin review app — Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only (never reaches a browser or device)
# ---------------------------------------------------------------------------

# Venue importer — connects directly to Postgres as a privileged dev user.
# Local default from `npm run db:start`:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# Overpass API. Comma-separated, tried in order on timeout/failure.
# Both public instances return HTTP 200 with an HTML error body when overloaded,
# so the importer validates the response is JSON before writing anything.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Required by the Overpass usage policy: identify your client with real contact
# info so operators can reach you instead of silently blocking the traffic.
OVERPASS_USER_AGENT=dropin-importer/0.1 (contact: you@example.com)
